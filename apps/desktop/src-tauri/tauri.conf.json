{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pathloom",
  "version": "0.1.0",
  "identifier": "dev.pathloom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:cli && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pathloom",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: plasset: http://plasset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pathloom"
    ],
    "resources": {
      "../../../THIRD-PARTY-LICENSES.md": "licenses/THIRD-PARTY-LICENSES.md",
      "../../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../../LICENSE-APACHE": "licenses/LICENSE-APACHE"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "publisher": "XxArDy",
    "shortDescription": "Whiteboard and roadmap for projects built with AI",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 XxArDy. MIT OR Apache-2.0"
  }
}
